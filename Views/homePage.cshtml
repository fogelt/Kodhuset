@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
  Layout = "~/Views/master.cshtml";
  var articleContent = Model.Value("htmldoc");
  var chartList = Model.Value<BlockListModel>("charts");
  string pageName = Model.Name + ".txt";
}

<div class="document-wrapper">
  <div class="document-header" style="display: flex; align-items: center; justify-content: space-between; gap: 5px;">
    <p style="margin-left: 10px;">@pageName.Replace(" ", "_")</p>
    @await Html.PartialAsync("decorationButtons")
  </div>
  <article class="document-container">
    @articleContent
    @if (chartList != null)
    {
      foreach (var chart in chartList)
      {
        var title = chart.Content.Value<string>("title");
        var description = chart.Content.Value<string>("desc");
        var chartItems = chart.Content.Value<BlockListModel>("chartItems");

        <section>
          <hr />

          <h2>@title</h2>
          <p>@description</p>

          @await Html.PartialAsync("pieChart", chartItems)
        </section>
      }
    }
  </article>
</div>