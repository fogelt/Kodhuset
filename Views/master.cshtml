@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
  var selection = Umbraco.ContentAtRoot()
      .FirstOrDefault();
}

<!doctype html>
<html lang="sv">

<head>
  <meta charset="utf-8">
  <title>@Model.Name</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/animations.css">
  @RenderSection("Head", required: false)
</head>

<body>
  <header
    style="text-align: center; border-bottom: 1px solid #3d3d3d; padding-bottom: 10px; width: 90%; margin-right: auto; margin-left: auto; ">
    @await Html.PartialAsync("skipButton")
    @await Html.PartialAsync("themeToggler")
    <a href="/" style="display: inline-block;" tabindex="-1">
      <img src="/kodhuset-logo.png"
           style="margin-bottom: 20px; margin-top: 20px; padding: 20px; border-radius: 10px; max-width: 70%; height: auto;"
           alt="Kodhusets logga" class="checker-container">
    </a>
    <nav style="border-top: 1px solid #3d3d3d; padding-top: 10px;">
      <a class="primary-btn" href="@selection!.Url()"
         style="margin-left: 5px; margin-right: 5px">@selection!.Name().ToUpper()</a>
      @foreach (var item in selection!.Children())
      {
        <a href="@item.Url()" class="primary-btn" style="margin-left: 5px; margin-right: 5px">@item.Name().ToUpper()</a>
      }
    </nav>
  </header>

  <main id="main">
    @RenderBody()
  </main>

  @await Html.PartialAsync("footer")

</body>

</html>