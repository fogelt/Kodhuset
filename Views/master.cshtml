@using Umbraco.Cms.Core.Models
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

@{
  var selection = Umbraco.ContentAtRoot()
      .FirstOrDefault();

  IPublishedContent? parentNode = Model.Parent();
}

<!doctype html>
<html lang="sv">

<head>
  <meta charset="utf-8">
  <title>@Model.Name</title>
  <link rel="stylesheet" href="/css/style.css">
  @RenderSection("Head", required: false)
</head>

<body>
  <header
    style="text-align: center; border-bottom: 1px solid #3d3d3d; padding-bottom: 10px; width: 90%; margin-right: auto; margin-left: auto;">
    <a href="/">
      <img src="/kodhuset-logo.png" style="margin-bottom: 20px; margin-top: 20px" alt="Kodhusets logga">
    </a>
    <nav style="border-top: 1px solid #3d3d3d; padding-top: 10px;">
      @foreach (var item in selection!.Children())
      {
        <li style="display: inline; margin-left: 5px; margin-right: 5px">
          <a href="@item.Url()">@item.Name().ToUpper()</a>
        </li>
      }
    </nav>
  </header>

  <main style="flex: 1;">
    @if (parentNode != null)
    {
      <a href="@parentNode.Url()" id="back-button"
         style="display: inline-block; margin: 15px 5%; cursor: pointer;">&larrhk;
        @parentNode.Name</a>
      }
      @RenderBody()
    </main>

    <footer>
      <p style="text-align: center; letter-spacing: 0.1rem; font-style: italic; font-weight: 100;">© 2026 Teknikern.
        Made with
        Umbraco.</p>
      </footer>

    </body>

  </html>