@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
  var selection = Umbraco.ContentAtRoot()
      .FirstOrDefault();

  IPublishedContent? parentNode = Model.Parent();
}

<!doctype html>
<html lang="sv">

<head>
  <meta charset="utf-8">
  <title>@Model.Name</title>
  <link rel="stylesheet" href="/css/style.css">
  @RenderSection("Head", required: false)
</head>

<body>
  <header
    style="text-align: center; border-bottom: 1px solid #3d3d3d; padding-bottom: 10px; width: 90%; margin-right: auto; margin-left: auto; ">
    @await Html.PartialAsync("themeToggler")
    <a href="/">
      <img src="/kodhuset-logo.png" style="margin-bottom: 20px; margin-top: 60px; padding: 20px; border-radius: 10px"
           alt="Kodhusets logga" class="checker-container">
    </a>
    <nav style="border-top: 1px solid #3d3d3d; padding-top: 10px;">
      <a class="primary-btn" href="@selection!.Url()"
         style="margin-left: 5px; margin-right: 5px">@selection!.Name().ToUpper()</a>
      @foreach (var item in selection!.Children())
      {
        <a href="@item.Url()" class="primary-btn" style="margin-left: 5px; margin-right: 5px">@item.Name().ToUpper()</a>
      }
    </nav>
  </header>

  <main style="flex: 1;">
    @if (parentNode != null)
    {
      <a href="@parentNode.Url()" id="back-button"
         style="display: inline-block; margin: 15px 5%; cursor: pointer;">&larrhk;
        @parentNode.Name</a>
      }
      @RenderBody()
    </main>

    <footer>
      <p style="text-align: center; letter-spacing: 0.1rem; font-style: italic; font-weight: 100;">© 2026 Kodhuset AB.
        Made with
        Umbraco.</p>
      </footer>

    </body>

  </html>