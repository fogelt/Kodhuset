@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
  Layout = "~/Views/master.cshtml";
  var articleContent = Model.Value("htmldoc");
  string pageName = Model.Name.ToLower() + ".txt";
  IEnumerable<IPublishedContent>? subLinks = Model.Children().Where(x => x.ContentType.Alias == "page");
  IEnumerable<IPublishedContent>? projects = Model.Children().Where(x => x.ContentType.Alias == "project");
  var coworkerList = Model.Value<BlockListModel>("coworkers");
  IPublishedContent? parentNode = Model.Parent();
}

<div class="document-wrapper">
  <div class="document-header" style="display: flex; align-items: center; justify-content: space-between; gap: 5px;">
    <p style="margin-left: 10px;">@pageName.Replace(" ", "_")</p>
    @await Html.PartialAsync("decorationButtons")
  </div>
  <article class="document-container">
    @if (parentNode != null)
    {
      <a href="@parentNode.Url()" id="back-button" class="primary-btn"
         style="display: inline-block; margin-top: 15px; margin-bottom: 5px; cursor: pointer;">&larrhk;
        @parentNode.Name</a>
      }
      <hr>
      @articleContent
      @if (projects.Any())
      {
        @await Html.PartialAsync("projectCarousel")
      }
      @if (coworkerList != null && coworkerList.Count() != 0)
      {
        <hr style="margin-top: 20px;" />
        <h2>Möt våra medarbetare</h2>
        <section style="display: flex; flex-wrap: wrap; gap: 40px; align-items: center; justify-content: center;">
          @await Html.PartialAsync("coworkerCard", coworkerList)
        </section>
      }
      @if (subLinks.Any())
      {
        <hr style="margin-top: 20px;" />
        <p>Du kanske också är interesserad av:</p>
        @foreach (var node in Model.Children())
        {
          <a href="@node.Url()" class="primary-btn" style="margin: 5px;">@node.Name.ToUpper()</a>
        }
      }

      