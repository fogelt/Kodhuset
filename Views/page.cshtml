@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
  Layout = Layout = "~/Views/Master.cshtml";
}

<h1>@Model.Name</h1>
<p>@Model.Value("infoText")</p>
<ul>
  @foreach (var node in Model.Children())
  {
    <li style="list-style-type: none;"><a href="@node.Url()">@node.Name</a></li>
  }
</ul>

