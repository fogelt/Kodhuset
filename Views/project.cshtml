@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Extensions
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

@{
  Layout = Layout = "~/Views/Master.cshtml";
    
  IPublishedContent? utvaldBild = Model.Value<IPublishedContent>("utvaldBild");
}

<h1>@Model.Name</h1>

<div>
  @Model.Value("beskrivning")
</div>

@if (utvaldBild != null)
{
  <img src="@utvaldBild.Url()" alt="@utvaldBild.Name" style="max-width: 400px; height: auto;" />
}

<p><strong>Kund:</strong> @Model.Value("kund")</p>
<p><strong>Teknik:</strong> @string.Join(", ", Model.Value<IEnumerable<string>>("teknik") ?? new string[0])</p>
